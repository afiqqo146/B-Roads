{
  "expo": {
    "name": "B-Roads",
    "slug": "b-roads",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.broads.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14161A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.broads.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "B-Roads uses your location to plan back-road routes, guide you and share your position with your group drive."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "B-Roads uses the camera to snap pit stop photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "B-Roads saves your pit stop photos so you can post them to Instagram.",
          "savePhotosPermission": "B-Roads saves your pit stop photos so you can post them to Instagram.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "react-native-share",
        {
          "ios": [
            "instagram",
            "instagram-stories",
            "fb",
            "facebook-stories"
          ],
          "android": [
            "com.instagram.android",
            "com.facebook.katana"
          ]
        }
      ]
    ],
    "scheme": "broads",
    "experiments": {
      "typedRoutes": true
    }
  }
}
